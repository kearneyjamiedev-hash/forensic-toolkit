# Optional local runtime overrides.
# Copy to your own shell/environment; the application does not require a .env
# file for normal local development.

# Explicit ExifTool path or command name.
# EXIFTOOL_PATH=C:\Tools\exiftool.exe

# Native logical-acquisition evidence root on Windows.
# LOCAL_EVIDENCE_ROOT=C:\ForensicEvidence

# Keep API docs disabled unless actively developing the API.
ENABLE_API_DOCS=0

# Local HTTP boundary.
HTTP_ALLOWED_HOSTS=127.0.0.1,localhost,::1
HTTP_ALLOWED_ORIGIN_HOSTS=127.0.0.1,localhost,::1
